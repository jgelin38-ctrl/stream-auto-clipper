# Streamer URL (Twitch, YouTube, etc.)
STREAMER_URL=https://www.twitch.tv/your_streamer_name

# Output directory for clips
OUTPUT_DIR=./clips

# Logs directory
LOG_DIR=./logs

# FFmpeg path (default: ffmpeg)
FFMPEG_PATH=ffmpeg

# Stream quality (best, 1080p60, 720p60, etc.)
QUALITY=best

# Twitch API credentials (optional)
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=

# Features
UPLOAD_TO_YOUTUBE=false
SAVE_LOCALLY=true
