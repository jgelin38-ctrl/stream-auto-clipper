# Multiple Streamer URLs
STREAMER_URL_1=https://www.twitch.tv/streamer1
STREAMER_URL_2=https://www.twitch.tv/streamer2

# Output directory for clips
OUTPUT_DIR=./clips

# Logs directory
LOG_DIR=./logs

# FFmpeg path (default: ffmpeg)
FFMPEG_PATH=ffmpeg

# Stream quality (best, 1080p60, 720p60, etc.)
QUALITY=best

# Twitch API credentials (optional)
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=

# Features
UPLOAD_TO_YOUTUBE=false
SAVE_LOCALLY=true

# Multi-threading configuration
MAX_CONCURRENT_STREAMS=2

# Chat Detection Settings
ENABLE_CHAT_DETECTION=true
CHAT_SPIKE_THRESHOLD=20
CHAT_WINDOW_SIZE=5
MIN_CHAT_MESSAGES=50
CLIP_BEFORE_SPIKE=10
CLIP_AFTER_SPIKE=30
EMOTES_TO_TRACK=PogU,KEKW,monkaS,OMEGALUL,Pog
EMOTE_TRIGGER_COUNT=10
